# GRIDPOINT Environment Variables
# Copy to .env and adjust as needed

PORT=3000
SESSION_SECRET=gridpoint_secure_secret_key_change_in_production
DATABASE_PATH=gridpoint.db

# Optional Supabase Integration (PostgreSQL / Auth / Storage)
# If provided, GRIDPOINT can synchronize with Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Map / Geocoding Services
MAP_PROVIDER_KEY=
